# MioClean Environment Variables

# GitHub Personal Access Token — used to call GitHub Models API (gpt-4o-mini, whisper-1)
# Generate one at: https://github.com/settings/tokens (no special scopes needed for public models)
GITHUB_TOKEN=your_github_token_here
INTERNAL_API_KEY=your_internal_api_key_here

PORT=3000
NODE_ENV=development
